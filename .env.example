# =============================================================================
# Umami production configuration
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate the secrets with:
#   openssl rand -hex 32        # for APP_SECRET
#   openssl rand -hex 32        # for TWO_FACTOR_ENCRYPTION_KEY (must be 64 hex chars)
#   openssl rand -hex 24        # for UMAMI_DB_PASSWORD
# =============================================================================

# ----- Database ----------------------------------------------------------------
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change_me_please_change_me_please_change_me

# ----- Umami secrets ----------------------------------------------------------
# Auth token signing key (any random hex string, 32+ chars recommended).
UMAMI_APP_SECRET=replace_with_openssl_rand_hex_32_output
# 64 hex chars — required to enable two-factor authentication.
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32_output_must_be_64_hex_chars_total
